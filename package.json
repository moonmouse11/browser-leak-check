{
  "name": "leak-check",
  "description": "Check your public IPv4/IPv6, WebRTC and DNS leaks, and browser fingerprint surface.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "postinstall": "wxt prepare",
    "check:sources": "tsx scripts/check-sources.ts",
    "check:release": "tsx scripts/check-release.ts",
    "test:docker": "sh scripts/test-docker.sh",
    "test:e2e:firefox": "playwright test --project=firefox",
    "build:e2e:firefox": "WXT_E2E_ECHO_URL=http://127.0.0.1:8787/ wxt build -b firefox"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/selenium-webdriver": "^4.35.7",
    "jsdom": "^30.1.1",
    "selenium-webdriver": "^4.49.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.1",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
